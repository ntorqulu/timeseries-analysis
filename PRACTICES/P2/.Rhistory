plot_hw_transforms <- function(a, b, c) {
# Original series
x0 <- AirPassengers
# Transformations
x1 <- x0
x2 <- log(x0)
x3 <- diff(log(x0))
x4 <- diff(x0, 12)
x5 <- diff(log(x0), 12)
x6 <- diff(diff(log(x0), 12))
# Holt-Winters fits
y1 <- HoltWinters(x1, alpha = a, beta = b, gamma = c)
y2 <- HoltWinters(x2, alpha = a, beta = b, gamma = c)
y3 <- HoltWinters(x3, alpha = a, beta = b, gamma = c)
y4 <- HoltWinters(x4, alpha = a, beta = b, gamma = c)
y5 <- HoltWinters(x5, alpha = a, beta = b, gamma = c)
y6 <- HoltWinters(x6, alpha = a, beta = b, gamma = c)
ylim <- range(x) # to fix same y-scale in the plot
# Layout
par(mfrow = c(2, 3), oma = c(0, 0, 3, 0))
# Plot AirPassengers
plot(x1,
ylim = ylim,
type="l",
col="grey",
main = "AirPassengers",
xlab="Time",
ylab="Value")
# add smoothed signal
lines(y1$fitted[,1], col="red", lwd=2)
# Plot log(AirPassengers)
plot(x2,
ylim = ylim,
type="l",
col="grey",
main = "log(AirPassengers)",
xlab="Time",
ylab="Value")
# add smoothed signal
lines(y2$fitted[,1], col="red", lwd=2)
# Plot diff(log(AirPassengers))
plot(x3,
ylim = ylim,
type="l",
col="grey",
main = "diff(log(AirPassengers))",
xlab="Time",
ylab="Value")
# add smoothed signal
lines(y3$fitted[,1], col="red", lwd=2)
# Plot diff(AirPassengers, 12)
plot(x4,
ylim = ylim,
type="l",
col="grey",
main = "diff(AirPassengers, 12)",
xlab="Time",
ylab="Value")
# add smoothed signal
lines(y4$fitted[,1], col="red", lwd=2)
# Plot diff(log(AirPassengers), 12)
plot(x5,
ylim = ylim,
type="l",
col="grey",
main = "diff(log(AirPassengers), 12)",
xlab="Time",
ylab="Value")
# add smoothed signal
lines(y5$fitted[,1], col="red", lwd=2)
# Plot diff(diff(log(AirPassengers), 12))
plot(x6,
ylim = ylim,
type="l",
col="grey",
main = "diff(diff(log(AirPassengers), 12))",
xlab="Time",
ylab="Value")
# add smoothed signal
lines(y6$fitted[,1], col="red", lwd=2)
# Global title
mtext(paste("a =", a, ", b =", b, ", c =", c), outer = TRUE, cex = 1.3)
}
# Initial values of a, b, c
plot_hw_transforms(0.2, 0.3, 0.8)
# Decrease only a (a was 0.2)
plot_hw_transforms(0.05, 0.3, 0.8)
# Decrease only b (b was 0.3)
plot_hw_transforms(0.2, 0.1, 0.8)
# Decrease only c (c was 0.8)
plot_hw_transforms(0.2, 0.3, 0.4)
# Decrease a, b, c
plot_hw_transforms(0.05, 0.1, 0.4)
# Increase only a
plot_hw_transforms(0.5, 0.3, 0.8)
