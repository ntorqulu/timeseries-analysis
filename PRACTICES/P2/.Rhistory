plot_hw_transforms <- function(a, b, c) {
# Original series
x0 <- AirPassengers
# Transformations
x1 <- x0
x2 <- log(x0)
x3 <- diff(log(x0))
x4 <- diff(x0, 12)
x5 <- diff(log(x0), 12)
x6 <- diff(diff(log(x0), 12))
# Holt-Winters fits
y1 <- HoltWinters(x1, alpha = a, beta = b, gamma = c)
y2 <- HoltWinters(x2, alpha = a, beta = b, gamma = c)
y3 <- HoltWinters(x3, alpha = a, beta = b, gamma = c)
y4 <- HoltWinters(x4, alpha = a, beta = b, gamma = c)
y5 <- HoltWinters(x5, alpha = a, beta = b, gamma = c)
y6 <- HoltWinters(x6, alpha = a, beta = b, gamma = c)
# Common y-scale
ylim <- range(
c(x1, x2, x3, x4, x5, x6,
y1$fitted[,1], y2$fitted[,1], y3$fitted[,1],
y4$fitted[,1], y5$fitted[,1], y6$fitted[,1]),
na.rm = TRUE
)
# Layout
par(mfrow = c(2,3), oma = c(0,0,3,0))
# Plot function
plot_hw <- function(x, y, title){
plot(x, col="grey60", ylim=ylim, main=title)
lines(y$fitted[,1], col="red", lwd=2)
}
plot_hw(x1, y1, "AirPassengers")
plot_hw(x2, y2, "log(AirPassengers)")
plot_hw(x3, y3, "diff(log(AirPassengers))")
plot_hw(x4, y4, "diff(AirPassengers, 12)")
plot_hw(x5, y5, "diff(log(AirPassengers), 12)")
plot_hw(x6, y6, "diff(diff(log(AirPassengers), 12))")
# Global title
mtext(paste("a =", a, ", b =", b, ", c =", c), outer = TRUE, cex = 1.3)
}
# Initial values of a, b, c
plot_hw_transforms(0.2, 0.3, 0.8)
# Decrease only a (a was 0.2)
plot_hw_transforms(0.05, 0.3, 0.8)
# Decrease only b (b was 0.3)
plot_hw_transforms(0.2, 0.1, 0.8)
# Decrease only c (c was 0.8)
plot_hw_transforms(0.2, 0.3, 0.4)
# Decrease a, b, c
plot_hw_transforms(0.05, 0.1, 0.4)
# Increase only a
plot_hw_transforms(0.5, 0.3, 0.8)
# Increase only b
plot_hw_transforms(0.2, 0.6, 0.8)
# Increase only c
plot_hw_transforms(0.2, 0.3, 0.9)
# Increase a, b, c
plot_hw_transforms(0.5, 0.6, 0.9)
plot_hw_transforms <- function(a, b, c) {
x1 <- AirPassengers
x2 <- log(x1)
x3 <- diff(log(x1))
x4 <- diff(x1, 12)
x5 <- diff(log(x1), 12)
x6 <- diff(diff(log(x1), 12))
y1 <- HoltWinters(x1, alpha = a, beta = b, gamma = c)
y2 <- HoltWinters(x2, alpha = a, beta = b, gamma = c)
y3 <- HoltWinters(x3, alpha = a, beta = b, gamma = c)
y4 <- HoltWinters(x4, alpha = a, beta = b, gamma = c)
y5 <- HoltWinters(x5, alpha = a, beta = b, gamma = c)
y6 <- HoltWinters(x6, alpha = a, beta = b, gamma = c)
# common scale ONLY for transformed series
ylim_trans <- range(
c(x2, x3, x4, x5, x6,
y2$fitted[,1], y3$fitted[,1],
y4$fitted[,1], y5$fitted[,1], y6$fitted[,1]),
na.rm = TRUE
)
par(mfrow=c(2,3), oma=c(0,0,3,0))
# original (own scale)
plot(x1, col="grey60", main="AirPassengers")
lines(y1$fitted[,1], col="red", lwd=2)
# transformed (same scale)
plot(x2, col="grey60", ylim=ylim_trans, main="log(AirPassengers)")
lines(y2$fitted[,1], col="red", lwd=2)
plot(x3, col="grey60", ylim=ylim_trans, main="diff(log(AirPassengers))")
lines(y3$fitted[,1], col="red", lwd=2)
plot(x4, col="grey60", ylim=ylim_trans, main="diff(AirPassengers,12)")
lines(y4$fitted[,1], col="red", lwd=2)
plot(x5, col="grey60", ylim=ylim_trans, main="diff(log(AirPassengers),12)")
lines(y5$fitted[,1], col="red", lwd=2)
plot(x6, col="grey60", ylim=ylim_trans, main="diff(diff(log(AirPassengers),12))")
lines(y6$fitted[,1], col="red", lwd=2)
mtext(paste("a =",a,", b =",b,", c =",c), outer=TRUE, cex=1.3)
}
# Initial values of a, b, c
plot_hw_transforms(0.2, 0.3, 0.8)
# Decrease only a (a was 0.2)
plot_hw_transforms(0.05, 0.3, 0.8)
# Decrease only b (b was 0.3)
plot_hw_transforms(0.2, 0.1, 0.8)
# Decrease only c (c was 0.8)
plot_hw_transforms(0.2, 0.3, 0.4)
# Decrease a, b, c
plot_hw_transforms(0.05, 0.1, 0.4)
# Increase only a
plot_hw_transforms(0.5, 0.3, 0.8)
# Increase only b
plot_hw_transforms(0.2, 0.6, 0.8)
# Increase only c
plot_hw_transforms(0.2, 0.3, 0.9)
# Increase a, b, c
plot_hw_transforms(0.5, 0.6, 0.9)
plot_hw_transforms <- function(a, b, c) {
# Series
x1 <- AirPassengers
x2 <- log(x1)
x3 <- diff(log(x1))
x4 <- diff(x1, 12)
x5 <- diff(log(x1), 12)
x6 <- diff(diff(log(x1), 12))
# Holt-Winters fits
y1 <- HoltWinters(x1, alpha = a, beta = b, gamma = c)
y2 <- HoltWinters(x2, alpha = a, beta = b, gamma = c)
y3 <- HoltWinters(x3, alpha = a, beta = b, gamma = c)
y4 <- HoltWinters(x4, alpha = a, beta = b, gamma = c)
y5 <- HoltWinters(x5, alpha = a, beta = b, gamma = c)
y6 <- HoltWinters(x6, alpha = a, beta = b, gamma = c)
# Shared scale for large-magnitude series
ylim_big <- range(
c(x1, x4, y1$fitted[,1], y4$fitted[,1]),
na.rm = TRUE
)
# Shared scale for log-based transformed series
ylim_small <- range(
c(x2, x3, x5, x6,
y2$fitted[,1], y3$fitted[,1], y5$fitted[,1], y6$fitted[,1]),
na.rm = TRUE
)
# Layout: 2 plots on top, 4 below
layout(matrix(c(1,2,
3,4,
5,6), nrow = 3, byrow = TRUE))
par(oma = c(0, 0, 3, 0), mar = c(4, 4, 3, 1))
plot_hw <- function(x, y, title, ylim) {
plot(x, col = "grey60", main = title, ylim = ylim)
lines(y$fitted[,1], col = "red", lwd = 2)
}
# Top row
plot_hw(x1, y1, "AirPassengers", ylim_big)
plot_hw(x4, y4, "diff(AirPassengers, 12)", ylim_big)
# Bottom 4
plot_hw(x2, y2, "log(AirPassengers)", ylim_small)
plot_hw(x3, y3, "diff(log(AirPassengers))", ylim_small)
plot_hw(x5, y5, "diff(log(AirPassengers), 12)", ylim_small)
plot_hw(x6, y6, "diff(diff(log(AirPassengers), 12))", ylim_small)
mtext(paste("a =", a, ", b =", b, ", c =", c), outer = TRUE, cex = 1.3)
}
# Initial values of a, b, c
plot_hw_transforms(0.2, 0.3, 0.8)
# Decrease only a (a was 0.2)
plot_hw_transforms(0.05, 0.3, 0.8)
# Decrease only b (b was 0.3)
plot_hw_transforms(0.2, 0.1, 0.8)
# Decrease only c (c was 0.8)
plot_hw_transforms(0.2, 0.3, 0.4)
# Decrease a, b, c
plot_hw_transforms(0.05, 0.1, 0.4)
# Increase only a
plot_hw_transforms(0.5, 0.3, 0.8)
# Increase only b
plot_hw_transforms(0.2, 0.6, 0.8)
# Increase only c
plot_hw_transforms(0.2, 0.3, 0.9)
# Increase a, b, c
plot_hw_transforms(0.5, 0.6, 0.9)
