# diff(log(x))
x<-diff(log(x))
y<-HoltWinters(x,alpha=a,beta=b, gamma=c)
plot(y, main = "Holt-Winters filtering with diff(log(AirPassenger))")
# diff(x,12)
x<-diff(x,12)
y<-HoltWinters(x,alpha=a,beta=b, gamma=c)
plot(y, main = "Holt-Winters filtering with diff(AirPassenger,12)")
# diff(log(AirPassengers), 12)
x<-diff(log(AirPassengers), 12)
y<-HoltWinters(x,alpha=a,beta=b, gamma=c)
plot(y, main = "Holt-Winters filtering with diff(log(AirPassengers)")
# diff(diff(log(AirPassengers), 12)
x<-diff(diff(log(AirPassengers), 12))
y<-HoltWinters(x,alpha=a,beta=b, gamma=c)
plot(y, main = "Holt-Winters filtering with diff(diff(log(AirPassengers), 12)")
